# Copy this file to ".env" (same folder as docker-compose.yml) to override defaults.
# Docker Compose reads ".env" automatically. All values below are optional and
# are the defaults. There are no secrets in this project.
#
# NOTE: the backend does NOT load ".env" itself. When running locally without Docker,
# set variables in PowerShell instead, for example:
#   $env:CHECK_TIMEOUT_SECONDS = "5"
#   uvicorn app.main:app --reload
# (DATABASE_URL is also supported locally; Compose sets its own for the container.)

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds to wait for the target site before giving up
CHECK_TIMEOUT_SECONDS=10

# Maximum redirects followed per check
MAX_REDIRECTS=5

# API URL used by the BROWSER. Baked into the frontend at build time:
# change it, then run "docker compose up -d --build".
VITE_API_URL=http://localhost:8000
